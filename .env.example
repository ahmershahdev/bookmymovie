#--------------------------------------------------------------------------
# BookMyMovie environment
# Local development values. For production set APP_ENV=production,
# APP_DEBUG=false, APP_URL to the https domain and SESSION_SECURE_COOKIE=true,
# then run: php artisan optimize
#--------------------------------------------------------------------------

APP_NAME=BookMyMovie
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BOOKMYMOVIE_CANONICAL_URL=https://bookmymovie.ahmershah.dev
BOOKMYMOVIE_CURRENCY=PKR
BOOKMYMOVIE_TIMEZONE=Asia/Karachi
BOOKMYMOVIE_MAX_SEATS=4
BOOKMYMOVIE_CART_HOLD_MINUTES=10
BOOKMYMOVIE_CANCELLATION_CUTOFF=120
# Leave empty to disable staff self-registration / recovery.
BOOKMYMOVIE_ADMIN_INVITE=
BOOKMYMOVIE_ADMIN_RECOVERY_SECRET=

#--- Passwords: argon2id, with bcrypt as the fallback on hosts without it ---
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
BCRYPT_ROUNDS=12

#--- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--- Database (XAMPP MySQL) -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookmymovie_dev
DB_USERNAME=root
DB_PASSWORD=

#--- Sessions, cache, queue -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
ADMIN_SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

#--- Email (Resend) ------------------------------------------------------------
# Create a key at https://resend.com/api-keys and verify your sending domain.
# Without a key, mail is written to storage/logs instead of being sent.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=support@ahmershah.dev
MAIL_FROM_NAME="${APP_NAME}"

#--- Social sign-in ------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

#--- Google reCAPTCHA (https://www.google.com/recaptcha/admin) -------------------
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5
RECAPTCHA_SKIP_GOOGLE_ON_LOCALHOST=true
FORM_MINIMUM_FILL_SECONDS=3

#--- Payments ------------------------------------------------------------------
# A method only appears at checkout once its keys are filled in.
# Cash at the counter is always available.
PAYMENTS_SANDBOX=true
# JazzCash merchant portal (sandbox: https://sandbox.jazzcash.com.pk)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Easypaisa hosted checkout (merchant portal)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# Cards via Stripe Checkout (https://dashboard.stripe.com/apikeys)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

#--- Abuse protection -----------------------------------------------------------
SHIELD_ENABLED=true
SHIELD_REQUESTS_PER_MINUTE=240
SHIELD_BURST_PER_10_SECONDS=60
SHIELD_STRIKES_BEFORE_BAN=5
SHIELD_BAN_MINUTES=30
SHIELD_MAX_BODY_KB=6144
SHIELD_ALLOWLIST=
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"

# Wallet passes on e-tickets (buttons appear once these are set)
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_FILE=

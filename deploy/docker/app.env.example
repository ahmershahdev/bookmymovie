APP_NAME=BookMyMovie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Karachi
BOOKMYMOVIE_CANONICAL_URL=https://bookmymovie.ahmershah.dev
BOOKMYMOVIE_ADMIN_PASSWORD=Admin@1234
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bookmymovie
DB_USERNAME=bookmymovie
DB_PASSWORD=bookmymovie
REDIS_HOST=redis
REDIS_CLIENT=phpredis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
MAIL_MAILER=log
HASH_DRIVER=argon2id
SHIELD_ENABLED=true
TRUSTED_PROXIES=
SEED_ON_BOOT=true
# Demo data only; the seeder refuses production without this.
SEED_ALLOW_PRODUCTION=true
